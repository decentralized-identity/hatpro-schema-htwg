@startuml
' TravelProfile.puml (root composition view)
' packages/travelProfile/puml/TravelProfile.puml

'Uncomment the one or both statements below to produce diagrams (notes with SCHEMA Hints hidden)
'VIEW_MODE - is for show/hide the SCHEMAHINTS (for generating JSON Schema,Enums,etc.)
'HIDE_COMMENTS - hide PUML notes that are not essential 
!define VIEW_MODE
!define HIDE_COMMENTS

skinparam classAttributeIconSize 0

' - same question re JSON Schema generated

/'
 These segments were auto generated by ChatGPT, they will be replaced
 with actual Segments (top priority after Nov 27 or 28 branch)
!include ../../identity/puml/IdentityInfo.puml
!include ../../contact/puml/ContactInfo.puml
!include ../../preferences/puml/FoodPreferences.puml
!include ../../support/puml/AccessibilitySupport.puml
'/
!include ../../name/puml/Name.puml
!include ../../personalCommInfo/puml/PersonalCommInfo.puml
!include ./commonLib/HATProIdentifier.puml
!include ../../physicalLocation/puml/PhysicalLocation.puml

class TravelProfile {
  +hatproIdentifier: HATProIdentifier
  +version: string
  +names: Name[]
  +personalCommInfo: PersonalCommInfo
  +physicalLocation: PhyscialLocation
}

TravelProfile "1" --> "0..*" Name :names
TravelProfile "1" --> "1" HATProIdentifier : hatproIdentifier
TravelProfile "1" --> "1" PersonalCommInfo
TravelProfile "1" --> "1" PhysicalLocation

' --- SCHEMAHINTS not displayed for diagram view (View_Mode)---
!ifndef VIEW_MODE
note right of TravelProfile
SCHEMAHINTS v0.1
title: TravelProfile
additionalProperties: false
required:[version, hatproIdentifier, personalCommInfo]

field hatproIdentifier:
  $ref: /core/commonLib/HATProIdentifier

field version:
  type: string
  valuePattern: ^\d+\.\d+\.\d+(-[A-Za-z0-9.-]+)?$
  default: 0.1.0

field names:
    type: array
    desc: structured name expressions for this traveler
    minItems: 1            ' optional, if you want at least one
    items:
      $ref: /name/Name

field personalCommInfo:
    type: object
    desc: personal communication properties
    $ref: /personalCommInfo/PersonalCommInfo

field physicalLocation:
    type: object
    desc: personal locations and addresses
    $ref: /physicalLocation/PhysicalLocation

end note
!endif
@enduml
