' Date.puml
@startuml

'Uncomment the statement below to produce diagrams (notes with SCHEMA Hints hidden)
'!define VIEW_MODE   
'!define HIDE_COMMENTS

skinparam classAttributeIconSize 0
class Date {
  +date: string 
}

!ifndef VIEW_MODE
note right of Date
SCHEMAHINTS v0.1
title: Date
additionalProperties: false
required:[date]

field date:
  type: string
  pattern: ^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$
  x-standard: ISO-8601
  x-standardRef: https://www.iso.org/iso-8601-date-and-time-format.html
  x-standardRef: https://en.wikipedia.org/wiki/ISO_8601
  default:2030-01-01
end note
!endif
@enduml
