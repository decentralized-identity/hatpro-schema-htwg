{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hatpro/core/TravelProfile.schema.json",
  "title": "TravelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hatproIdentifier": {
      "$ref": "https://schemas.example.org/hatpro/core/commonLib/HATProIdentifier.schema.json"
    },
    "version": {
      "default": "0.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "names": {
      "description": "structured name expressions for this traveler",
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.org/hatpro/name/Name.schema.json"
      }
    },
    "personalCommInfo": {
      "description": "personal communication properties",
      "$ref": "https://schemas.example.org/hatpro/personalCommInfo/PersonalCommInfo.schema.json"
    },
    "physicalLocation": {
      "description": "personal locations and addresses",
      "$ref": "https://schemas.example.org/hatpro/physicalLocation/PhysicalLocation.schema.json"
    }
  },
  "required": [
    "version",
    "hatproIdentifier",
    "personalCommInfo"
  ]
}