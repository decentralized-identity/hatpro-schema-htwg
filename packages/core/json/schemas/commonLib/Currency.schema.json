{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hatpro/core/commonLib/Currency.schema.json",
  "title": "Currency",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "description": "Monetary amount as a string; optional leading '-', exactly 2 decimal digits; no thousands separators; up to 12 digits before the decimal",
      "default": "$0.00",
      "pattern": "^-?(?:0|[1-9]\\d{0,11})\\.\\d{2}$",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "type": "string",
      "x-enumValuesFrom": "/core/json/enums/commonLib/CurrencyTypeEnum.json"
    }
  },
  "required": [
    "amount",
    "currency"
  ]
}