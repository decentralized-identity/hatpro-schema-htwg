{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hatpro/core/commonLib/HATProIdentifier.schema.json",
  "title": "HATProIdentifier",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "uuid7": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "verifiableIdentifier": {
      "pattern": "^did:[a-z0-9]+:[A-Za-z0-9.\\-_:]+$",
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "uuid7"
      ]
    },
    {
      "required": [
        "verifiableIdentifier"
      ]
    }
  ]
}