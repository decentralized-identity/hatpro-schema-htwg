@startuml
skinparam classAttributeIconSize 0
'Uncomment the statement below to produce diagrams (notes with SCHEMA Hints hidden)
'!define VIEW_MODE   
'!define HIDE_COMMENTS

class RankedLanguageSkill {
  +skill       : Integer
  +ranking     : Integer
}

!ifndef VIEW_MODE
note right of RankedLanguageSkill
SCHEMAHINTS v0.1
title: RankedLanguageSkill

required:[ranking, proficiencyLevel, languageLocale]

field languageLocale:
  $ref: /core/commonLib/LanguageLocale
  desc: Traveler-selected BCP-47 language tag (governed list).

field proficiencyLevel:
  type: integer
  range: [0, 10]
  default: 0
  desc: 0 = no ability; 10 = fully proficient for travel purposes.

field ranking:
  type: integer
  range: [0, 10]
  default: 0
  desc: Relative ranking among the traveler’s preferred languages for this use.
end note
!endif

@enduml
