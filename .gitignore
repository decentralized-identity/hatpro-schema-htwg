# ============================================================
# HATPro repo ignore rules
#
# Principle:
# - Track source models, published JSON schemas, examples,
#   templates, components, docs, scripts, tools, and diagrams
# - Ignore only local tooling artifacts, logs, caches,
#   scratch work, and temporary files
#
# Scratch work should be placed in /working/ folders anywhere
# in the repository tree.
# ============================================================

# Node / tooling
node_modules/
.npm/
.cache/

# ignore working directories under each of the top folders
**/working/

#File types to ignore

# Logs / temp / backup files
*.log
*.tmp
*.bak
*.old
*.orig
*.zip

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/.history/

# Tool-specific generated files
ajv.log
